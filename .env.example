# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

# ============================================================================
# HARDWARE INVENTORY (from CPU-Z report, C:\Users\cvsz.ZEAZ\Documents\ZEAZ.html)
# ============================================================================
# CPU:    AMD Ryzen 5 3400G with Radeon Vega Graphics (4C/8T, Socket AM4, 12nm)
# GPU:    Integrated Radeon Vega Graphics (APU) — NO discrete GPU installed
# Memory: 32 GB DDR4 (2×16 GB SK Hynix, DDR4-3200, XMP-3200)
# Board:  MSI A520M-A PRO (MS-7C96), AMD A520 chipset, PCIe 3.0 x16 (empty slot)
# LPCIO:  Nuvoton NCT6687 (hardware monitoring, potential GPIO/I2C)
# Audio:  Via AMD A520 chipset (Realtek typically) — not confirmed in report
#
# IMPLICATIONS:
#   - Phase 4 (Voice):   Microphone/speakers likely available via motherboard audio;
#                        STT/TTS API credentials still required (external service).
#   - Phase 5 (Vision):  Integrated Vega GPU only — no CUDA/ROCm discrete GPU;
#                        vision model API credentials still required.
#   - Phase 9 (SmartEnv): Nuvoton NCT6687 LPCIO could support GPIO/I2C; IoT devices
#                        and MQTT broker still required.
# ============================================================================


# --- Application -------------------------------------------------------------
JARVIS_APP_ENV=development
JARVIS_LOG_LEVEL=info
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=false

# --- Database connection (PostgreSQL) ---------------------------------------
JARVIS_DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_DATABASE_ECHO=false
JARVIS_DATABASE_POOL_SIZE=10
JARVIS_DATABASE_MAX_OVERFLOW=20

# --- Security ----------------------------------------------------------------
JARVIS_APP_SECRET=dev-secret-change-me-in-production
JARVIS_ACCESS_TOKEN_EXPIRE_MINUTES=30
JARVIS_ALGORITHM=HS256

# --- Model gateway -----------------------------------------------------------
JARVIS_MODEL_GATEWAY_ENABLED=true
JARVIS_CLOUD_FALLBACK_ENABLED=false
JARVIS_DEFAULT_PROVIDER=local
JARVIS_DEFAULT_MODEL=local-model
JARVIS_MAX_TOKENS=4096
JARVIS_REQUEST_TIMEOUT_SECONDS=120

# --- Ollama (local model server) ---------------------------------------------
# Ollama runs locally on consumer hardware; no external credentials required.
# Set JARVIS_OLLAMA_BASE_URL to enable the ollama provider in the model gateway.
# Inside Docker Compose use the service name: http://ollama:11434
# JARVIS_OLLAMA_BASE_URL=http://localhost:11434
# JARVIS_OLLAMA_DEFAULT_MODEL=llama3   # e.g. llama3, zcoder-promax

# --- Feature flags -----------------------------------------------------------
JARVIS_VOICE_ENABLED=false
JARVIS_VISION_ENABLED=false
JARVIS_AGENT_RUNTIME_ENABLED=true
JARVIS_SMART_ENVIRONMENT_ENABLED=false

# --- Voice Intelligence (Phase 4) -------------------------------------------
# Requires audio hardware + STT/TTS provider credentials. Disabled by default.
# Set JARVIS_VOICE_ENABLED=true to enable; provider keys come from env only.
# JARVIS_VOICE_STT_PROVIDER=REPLACE_ME    # e.g. azure, aws, google, nvidia, local
# JARVIS_VOICE_STT_API_KEY=REPLACE_ME     # STT provider API key
# JARVIS_VOICE_STT_API_URL=https://integrate.api.nvidia.com/v1  # NVIDIA NIM STT endpoint (optional)
# JARVIS_VOICE_TTS_PROVIDER=REPLACE_ME    # e.g. azure, aws, google, nvidia, local
# JARVIS_VOICE_TTS_API_KEY=REPLACE_ME     # TTS provider API key
# JARVIS_VOICE_TTS_API_URL=https://integrate.api.nvidia.com/v1  # NVIDIA NIM TTS endpoint (optional)
# JARVIS_VOICE_AUDIO_INPUT_DEVICE=REPLACE_ME  # microphone device id (optional)
# JARVIS_VOICE_AUDIO_OUTPUT_DEVICE=REPLACE_ME # speaker device id (optional)

# --- Vision Intelligence (Phase 5) ------------------------------------------
# Requires GPU hardware + vision model provider credentials. Disabled by default.
# Set JARVIS_VISION_ENABLED=true to enable; provider keys come from env only.
# JARVIS_VISION_PROVIDER=REPLACE_ME       # e.g. nvidia-nim, openai, local
# JARVIS_VISION_API_KEY=REPLACE_ME        # vision model API key
# JARVIS_VISION_API_URL=https://integrate.api.nvidia.com/v1  # NVIDIA NIM endpoint (optional)
# JARVIS_VISION_MODEL=REPLACE_ME          # vision model name (e.g. nemotron, gpt-4v)
# JARVIS_VISION_GPU_DEVICE=cpu            # Vision inference device (cpu or cuda:0). Defaults to CPU fallback.
# JARVIS_VISION_MAX_IMAGE_BYTES=10485760  # max image upload size in bytes (default 10 MB)

# --- Smart Environment / IoT (Phase 9) --------------------------------------
# Requires IoT hardware + device credentials. Disabled by default.
# Set JARVIS_SMART_ENVIRONMENT_ENABLED=true to enable.
# JARVIS_SMART_ENV_PROVIDER=REPLACE_ME    # e.g. mqtt, zigbee, zwave, matter
# JARVIS_SMART_ENV_BROKER_URL=REPLACE_ME  # MQTT broker URL (e.g. mqtt://localhost:1883)
# JARVIS_SMART_ENV_BROKER_USER=REPLACE_ME # broker username (optional)
# JARVIS_SMART_ENV_BROKER_PASS=REPLACE_ME # broker password (optional)
# JARVIS_SMART_ENV_DEVICE_IDS=REPLACE_ME  # comma-separated device ids
# JARVIS_SMART_ENV_DISCOVERY_ENABLED=false

# --- OpenTelemetry tracing ---------------------------------------------------
JARVIS_TRACING_ENABLED=false
# JARVIS_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Backup / Restore --------------------------------------------------------
# JARVIS_BACKUP_DIR=./backups
# BACKUP_RECIPIENT=REPLACE_ME   # age encryption recipient for encrypted backups