# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Shared Docker database and cache (placeholders — replace with project values)
# DATABASE_URL and TEST_DATABASE_URL point at a shared PostgreSQL service.
# Database and Redis passwords are read from runtime secret files at deploy time.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<db_user>:<db_password>@<postgres_host>:<postgres_port>/<db_name>
TEST_DATABASE_URL=postgresql://<db_user>:<db_password>@<postgres_host>:<postgres_port>/<db_name>
REPONAME_POSTGRES_HOST=<postgres_host>
REPONAME_POSTGRES_PORT="5432"
REPONAME_POSTGRES_PASSWORD_FILE=/run/secrets/<project>_postgres_password
REPONAME_REDIS_HOST=<redis_host>
REPONAME_REDIS_PORT="6379"
REPONAME_REDIS_PASSWORD_FILE=/run/secrets/<project>_redis_password
